{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sedot",
  "version": "0.9.0",
  "identifier": "id.sedot.app",
  "build": {
    "frontendDist": "ui-dist",
    "beforeBuildCommand": "node scripts/build-ui.js",
    "beforeDevCommand": "node scripts/build-ui.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "resources": { "../extension/": "extension/" },
    "windows": {
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    }
  }
}
