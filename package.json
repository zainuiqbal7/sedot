{
  "name": "sedot",
  "productName": "Sedot",
  "version": "0.1.0",
  "description": "Download manager multi-koneksi dengan integrasi browser",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/get-aria2.js",
    "get-aria2": "node scripts/get-aria2.js",
    "start": "electron .",
    "test": "node test/engine.test.js",
    "icons": "node scripts/make-icons.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "id.sedot.app",
    "productName": "Sedot",
    "files": ["src/**", "assets/**", "package.json"],
    "extraResources": [{ "from": "bin", "to": "bin", "filter": ["aria2c.exe", "aria2-*"] }],
    "win": { "target": ["nsis", "portable"], "icon": "assets/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
