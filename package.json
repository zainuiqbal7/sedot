{
  "name": "sedot",
  "productName": "Sedot",
  "version": "0.4.0",
  "description": "Download manager multi-koneksi dengan integrasi browser",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/get-aria2.js",
    "get-aria2": "node scripts/get-aria2.js",
    "start": "electron .",
    "test": "node test/helpers.test.js && node test/engine.test.js",
    "icons": "node scripts/make-icons.js",
    "dist": "electron-builder --win --publish never",
    "test:e2e": "node test/e2e.test.js"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.65.0"
  },
  "build": {
    "appId": "id.sedot.app",
    "productName": "Sedot",
    "files": [
      "src/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "aria2c.exe",
          "aria2-*"
        ]
      },
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "Sedot-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sedot",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "zainuiqbal7",
        "repo": "sedot",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "author": "zainuiqbal7",
  "repository": {
    "type": "git",
    "url": "https://github.com/zainuiqbal7/sedot.git"
  }
}
